   <!DOCTYPE html>
<html lang="en">
    <head> 
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Oswald&display=swap" rel="stylesheet">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Protest+Revolution&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet"
            integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
        <link rel="stylesheet" href="/css/style.css">
        <title>Document</title>
    </head>
<body>
     
   <%-include('../partials/header.ejs')%>
    <section id="mid">
        <div class="container">
            <div class="row">
                <%-include('../partials/left.ejs')%>
                <div class="col-md-9">
                    <h3>Out Parking Management</h3>
                    <table class="table table-hover"> 
                        <thead>
                            <tr>
                                <th>S.No.</th>
                                <th>VehicleNo.</th>
                                <th>Entery Time</th>
                                <th>Out Time</th>
                                <th>Veh.Type</th>
                                <th>Amount</th>
                                <th>Parked Date</th>
                                <th>status</th>
                                <th>Print</th>
                            </tr>
                        </thead>
                        <tbody>
                           <%record.forEach((element,key)=>{%>
                            <tr>
                                <td><%=key+1%></td>
                                <td><%=element.vno%></td>
                                <td><%=element.vin%></td>
                                <td><%=element.vout%></td>
                                <td><%=element.vtype%></td>
                                <td><%=element.amount%></td>
                                <td><%=element.parkedDate%></td>
                                <%if(element.status=='out'){%>
                                    <td><a href="/parkingUpdate/<%=element.id%>"><button class="" disabled><%=element.status%></button></a></td>
                                <%}else{%>
                                    <td><a href="/parkingUpdate/<%=element.id%>"><button class=""><%=element.status%></button></a></td>

                                <%}%>
                                <%if(element.status=='out'){%>
                                    <td><a href="/print/<%=element.id%>"><button >print</button></a></td>
                                <%}else{%>
                                    <td><a href="/print/<%=element.id%>"><button disabled>print</button></a></td>
                                <%}%>
                            </tr>
                           <%})%>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
    <%-include('../partials/footer.ejs')%>
   
</body>
</html>
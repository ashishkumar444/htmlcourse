<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet"
            integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
            <link rel="stylesheet" href="/css/style.css">

            <title>Document</title>
</head> 
<body>
    <section id="print">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-5">
                   
                    <table class="table table-hover">
                        <tr>
                            <th>Excellence parking area</th>
                        </tr>
                        <tr>
                            <td>Vehicle No. :- <%=record.vno%></td>
                        </tr>
                      <%if(record.vtype=='2w'){%>
                        <tr>
                            <td>Vehicle Type :- Two wheeler</td>
                        </tr>
                      <%}else if(record.vtype=='3w'){%>
                        <tr>
                            <td>Vehicle Type :- Three wheeler</td>
                        </tr>
                      <%}else if(record.vtype=='4w'){%>
                        <tr>
                            <td>Vehicle Type :- Four wheeler</td>
                        </tr>
                      <%}else if(record.vtype=='hw'){%>
                        <tr>
                            <td>Vehicle Type :- Heavy wheeler</td>
                        </tr>
                       <%}else if(record.vtype=='lw'){%>
                        <tr>
                            <td>Vehicle Type :- Light wheeler</td>
                        </tr>
                       <%}else if(record.vtype=='other'){%>
                        <tr>
                            <td>Vehicle Type :- Other wheeler</td>
                        </tr>
                       <%}%>
                        
                       <tr>
                        <td>In Time :- <%=record.vin%></td>
                    </tr>
                    <tr>  
                        <td>Out Time :- <%=record.vout%></td>
                    </tr>
                    <tr>
                        <td>Total Time :- <%=totaltiming%></td>
                    </tr>
                    <tr>
                        <td>Amount :-  <%=record.amount%></td>
                    </tr>
                    </table>
                </div>
            </div>
        </div> 
    </section>
    <script>
        // Call the window.print() function when the page loads
        window.onload = function() {
          window.print();
        };
      </script>
</body>
</html>